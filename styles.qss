/* AutoEventTracker - modern desktop theme */

QWidget {
    background: transparent;
    color: #172033;
    font-family: "Inter", "SF Pro Text", "Segoe UI", "Hiragino Sans", "Yu Gothic UI", sans-serif;
    font-size: 13px;
}

QMainWindow,
QStackedWidget {
    background-color: #F4F7FB;
}

QToolTip {
    background-color: #172033;
    color: #FFFFFF;
    border: 0;
    padding: 6px 9px;
}

/* Typography */
#mainTitle {
    color: #111827;
    font-size: 28px;
    font-weight: 700;
}

#descLabel {
    color: #667085;
    font-size: 12px;
}

#sectionTitle {
    color: #111827;
    font-size: 24px;
    font-weight: 700;
}

#logTitle,
QLabel[class="bold-label"] {
    color: #344054;
    font-size: 12px;
    font-weight: 600;
}

/* Surfaces */
#projectBar,
#infoFrame,
#formFrame {
    background-color: #FFFFFF;
    border: 1px solid #E4E9F2;
    border-radius: 12px;
}

#projectBar QLabel,
#infoFrame QLabel {
    background: transparent;
}

#infoFrame {
    min-height: 144px;
}

#infoUrlLabel {
    color: #4F46E5;
    font-family: "SF Mono", "JetBrains Mono", "Menlo", monospace;
    font-size: 12px;
    font-weight: 600;
}

#infoMemoLabel {
    color: #475467;
}

/* Tabs */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E4E9F2;
    border-radius: 14px;
    top: -1px;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: transparent;
    color: #667085;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 11px 18px;
    margin-right: 4px;
    min-width: 180px;
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #344054;
    background-color: #F8FAFC;
}

QTabBar::tab:selected {
    color: #4F46E5;
    border-bottom: 2px solid #4F46E5;
    background-color: #FFFFFF;
}

/* Inputs */
QLineEdit,
QComboBox,
QTextEdit {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DDE8;
    border-radius: 8px;
    selection-background-color: #C7D2FE;
    selection-color: #172033;
}

QLineEdit,
QComboBox {
    min-height: 22px;
    padding: 8px 11px;
}

QLineEdit:hover,
QComboBox:hover {
    border-color: #AEB8C8;
}

QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 1px solid #6366F1;
    background-color: #FFFFFF;
}

QLineEdit[dragOver="true"] {
    background-color: #EEF2FF;
    border: 2px dashed #6366F1;
}

QComboBox {
    padding-right: 30px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border: none;
    border-left: 1px solid #EEF1F6;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D7DDE8;
    padding: 5px;
    outline: none;
    selection-background-color: #EEF2FF;
    selection-color: #3730A3;
}

/* Buttons */
QPushButton {
    min-height: 22px;
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid transparent;
    font-size: 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F5F7FA;
}

QPushButton:pressed {
    padding-top: 9px;
    padding-bottom: 7px;
}

#primaryBtn,
#actionBtn {
    background-color: #4F46E5;
    color: #FFFFFF;
    border-color: #4F46E5;
}

#primaryBtn:hover,
#actionBtn:hover {
    background-color: #4338CA;
    border-color: #4338CA;
}

#primaryBtn:pressed,
#actionBtn:pressed {
    background-color: #3730A3;
    border-color: #3730A3;
}

#actionBtn,
#dangerBtn {
    min-height: 28px;
    padding: 10px 18px;
    font-size: 13px;
}

#secondaryBtn {
    background-color: #FFFFFF;
    color: #344054;
    border-color: #D7DDE8;
}

#secondaryBtn:hover {
    background-color: #F8FAFC;
    border-color: #AEB8C8;
}

#successBtn {
    background-color: #ECFDF3;
    color: #027A48;
    border-color: #ABEFC6;
}

#successBtn:hover {
    background-color: #D1FADF;
    border-color: #75E0A7;
}

#dangerBtn {
    background-color: #FFF1F3;
    color: #C01048;
    border-color: #FECDD6;
}

#dangerBtn:hover {
    background-color: #FFE4E8;
    border-color: #FDA4B4;
}

QPushButton:disabled {
    background-color: #EAECF0;
    color: #98A2B3;
    border-color: #EAECF0;
}

/* Checkboxes */
QCheckBox {
    color: #475467;
    spacing: 8px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    background-color: #FFFFFF;
    border: 1px solid #C8D0DD;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #6366F1;
}

QCheckBox::indicator:checked {
    background-color: #4F46E5;
    border-color: #4F46E5;
}

/* Progress and console */
QProgressBar {
    min-height: 5px;
    max-height: 5px;
    background-color: #E9ECF2;
    border: none;
    border-radius: 2px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #6366F1;
    border-radius: 2px;
}

#logConsole {
    background-color: #111827;
    color: #D1E9FF;
    border: 1px solid #202A3A;
    border-radius: 12px;
    padding: 14px;
    font-family: "SF Mono", "JetBrains Mono", "Menlo", "Courier New", monospace;
    font-size: 11px;
    selection-background-color: #344054;
    selection-color: #FFFFFF;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 9px;
    margin: 3px;
}

QScrollBar::handle:vertical {
    background-color: #C9D1DE;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #98A2B3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* Dialogs */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #172033;
    background: transparent;
}

QMessageBox QPushButton {
    min-width: 76px;
    background-color: #4F46E5;
    color: #FFFFFF;
    border-color: #4F46E5;
}

QMessageBox QPushButton:hover {
    background-color: #4338CA;
}
