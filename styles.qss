/* STREAMING_CHUNK:Defining CSS variables and global reset... /
/ ==========================================🎨 AutoEventTracker - Modern Slate & Indigo Theme========================================== *//* 全体基本設定 */QWidget {font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "游ゴシック Medium", "Yu Gothic Medium", "Hiragino Sans", sans-serif;font-size: 13px;color: #1E293B;background-color: #F8FAFC;}/* ヘッダータイトル */#mainTitle {font-size: 24px;font-weight: 800;color: #0F172A;letter-spacing: -0.5px;}#sectionTitle {font-size: 22px;font-weight: 700;color: #0F172A;}/* ラベル */.bold-label {font-weight: 600;font-size: 13px;color: #334155;}/* STREAMING_CHUNK:Styling input elements and combo boxes... /
/ 入力フィールド */QLineEdit {padding: 10px 14px;font-size: 13px;border: 1px solid #CBD5E1;border-radius: 8px;background-color: #FFFFFF;color: #0F172A;selection-background-color: #6366F1;}QLineEdit:focus {border: 2px solid #6366F1;background-color: #FFFFFF;}/* ドラッグ＆ドロップ対応入力欄 */DragDropLineEdit {padding: 10px 14px;font-size: 13px;border: 1px dashed #94A3B8;border-radius: 8px;background-color: #FFFFFF;color: #0F172A;}DragDropLineEdit:hover {border-color: #6366F1;background-color: #F1F5F9;}DragDropLineEdit[dragOver="true"] {border: 2px solid #10B981;background-color: #ECFDF5;}/* コンボボックス */QComboBox {padding: 8px 12px;font-size: 13px;min-width: 220px;border: 1px solid #CBD5E1;border-radius: 8px;background-color: #FFFFFF;color: #0F172A;}QComboBox:hover {border-color: #94A3B8;}QComboBox::drop-down {subcontrol-origin: padding;subcontrol-position: top right;width: 28px;border-left-width: 0px;border-top-right-radius: 8px;border-bottom-right-radius: 8px;}/* STREAMING_CHUNK:Styling buttons and tabs... /
/ ボタン基本スタイル */QPushButton {padding: 10px 18px;border-radius: 8px;font-weight: 600;font-size: 13px;border: none;}/* プライマリボタン (インディゴ) */QPushButton#primaryBtn {background-color: #4F46E5;color: #FFFFFF;}QPushButton#primaryBtn:hover {background-color: #4338CA;}QPushButton#primaryBtn:pressed {background-color: #3730A3;}/* 新規作成ボタン (エメラルド) */QPushButton#successBtn {background-color: #10B981;color: #FFFFFF;}QPushButton#successBtn:hover {background-color: #059669;}/* アクション/実行ボタン (スマートブルー) */QPushButton#actionBtn {background-color: #2563EB;color: #FFFFFF;padding: 14px;font-size: 14px;}QPushButton#actionBtn:hover {background-color: #1D4ED8;}/* 記録ボタン (ローズ) */QPushButton#dangerBtn {background-color: #E11D48;color: #FFFFFF;padding: 14px;font-size: 14px;}QPushButton#dangerBtn:hover {background-color: #BE123C;}/* 二次操作ボタン (ニュートラルグレー) */QPushButton#secondaryBtn {background-color: #E2E8F0;color: #334155;}QPushButton#secondaryBtn:hover {background-color: #CBD5E1;}/* タブウィジェット (ピル風コントロール) */QTabWidget::pane {border: 1px solid #E2E8F0;background: #FFFFFF;border-radius: 12px;margin-top: -1px;}QTabBar::tab {background: #F1F5F9;color: #64748B;padding: 10px 22px;font-weight: 600;border-radius: 8px;margin-right: 6px;margin-bottom: 8px;}QTabBar::tab:selected {background: #4F46E5;color: #FFFFFF;}QTabBar::tab:hover:!selected {background: #E2E8F0;color: #334155;}/* STREAMING_CHUNK:Styling frames, checkable controls, and console log... /
/ カード風フレーム */#infoFrame {background-color: #F8FAFC;border: 1px solid #E2E8F0;border-radius: 10px;}#formFrame {background-color: #FFFFFF;border: 1px solid #E2E8F0;border-radius: 12px;}/* チェックボックス */QCheckBox {font-weight: 500;color: #334155;spacing: 8px;}/* ログ表示エリア (ダークターミナル風) */#logConsole {background-color: #0F172A;color: #38BDF8;font-family: "JetBrains Mono", "Menlo", "Consolas", monospace;font-size: 12px;line-height: 1.5;padding: 14px;border-radius: 10px;border: 1px solid #1E293B;}/* 説明テキスト */#descLabel {color: #64748B;font-size: 12px;line-height: 1.6;}#infoUrlLabel {color: #2563EB;font-family: "JetBrains Mono", "Menlo", "Consolas", monospace;font-size: 12px;}