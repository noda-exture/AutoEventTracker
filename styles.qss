/* ==========================================AutoEventTracker - Modern Clean Theme (QSS)========================================== */
/* --- 全体基本設定 --- */
QWidget {
  font-family: BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
  color: #1E293B;
  background-color: transparent;
  font-size: 13px;
}

QMainWindow {
  background-color: #F8FAFC;
}

/* --- タイポグラフィ・ラベル --- */
#mainTitle {
  font-size: 24px;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: -0.5px;
}

#sectionTitle {
  font-size: 20px;
  font-weight: 700;
  color: #0F172A;
}

#descLabel {
  color: #64748B;
  font-size: 13px;
  line-height: 1.5;
}

.bold-label {
  font-size: 13px;
  font-weight: 600;
  color: #334155;
}

/* --- カード・枠コンポーネント --- */
#infoFrame {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  min-height: 150px;
}

#infoFrame QLabel {
  padding-top: 2px;
  padding-bottom: 2px;
  font-size: 13px;
}

#formFrame {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
}

#infoUrlLabel {
  color: #2563EB;
  font-family: "SF Mono", "JetBrains Mono", "Menlo", monospace;
  font-size: 13px;
  font-weight: 600;
}

#infoMemoLabel {
  color: #334155;
  font-size: 13px;
  line-height: 1.5;
}

/* --- タブウィジェット (Segmented Pill Style) --- */
QTabWidget::pane {
  border: 1px solid #E2E8F0;
  border-radius: 14px;
  background-color: #FFFFFF;
  top: -1px;
}

QTabBar {
  background: transparent;
  qproperty-drawBase: 0;
}

QTabBar::tab {
  background-color: #F1F5F9;
  color: #64748B;
  font-weight: 600;
  font-size: 13px;
  padding: 8px 18px;
  margin-right: 6px;
  margin-bottom: 8px;
  border-radius: 8px;
  border: 1px solid transparent;
}

QTabBar::tab:hover {
  background-color: #E2E8F0;
  color: #1E293B;
}

QTabBar::tab:selected {
  background-color: #2563EB;
  color: #FFFFFF;
  border: 1px solid #2563EB;
}

/* --- フォーム入力・コンボボックス --- */
QLineEdit {
  background-color: #FFFFFF;
  border: 1px solid #CBD5E1;
  border-radius: 8px;
  padding: 9px 12px;
  font-size: 13px;
  color: #0F172A;
}

QLineEdit:focus {
  border: 1px solid #2563EB;
  background-color: #FFFFFF;
}

QLineEdit[dragOver="true"] {
  border: 2px dashed #2563EB;
  background-color: #EFF6FF;
}

QComboBox {
  background-color: #FFFFFF;
  border: 1px solid #CBD5E1;
  border-radius: 8px;
  padding: 7px 12px;
  font-size: 13px;
  color: #0F172A;
  min-height: 20px;
}

QComboBox:focus {
  border: 1px solid #2563EB;
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 28px;
  border-left: 1px solid #E2E8F0;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
  background-color: #FFFFFF;
  border: 1px solid #CBD5E1;
  border-radius: 8px;
  padding: 4px;
  selection-background-color: #EFF6FF;
  selection-color: #1D4ED8;
}

/* --- ボタン共通・バリエーション --- */
QPushButton {
  font-weight: 600;
  font-size: 13px;
  border-radius: 8px;
  padding: 9px 16px;
  border: 1px solid transparent;
}

/* Primary (Indigo/Blue) */
#primaryBtn {
  background-color: #2563EB;
  color: #FFFFFF;
}

#primaryBtn:hover {
  background-color: #1D4ED8;
}

#primaryBtn:pressed {
  background-color: #1E40AF;
}

/* Secondary (Outline/Slate) */
#secondaryBtn {
  background-color: #FFFFFF;
  color: #334155;
  border: 1px solid #CBD5E1;
}

#secondaryBtn:hover {
  background-color: #F8FAFC;
  border-color: #94A3B8;
}

#secondaryBtn:pressed {
  background-color: #F1F5F9;
}

/* Success (Emerald) */
#successBtn {
  background-color: #059669;
  color: #FFFFFF;
}

#successBtn:hover {
  background-color: #047857;
}

#successBtn:pressed {
  background-color: #065F46;
}

/* Action (Blue) */
#actionBtn {
  background-color: #0284C7;
  color: #FFFFFF;
  font-size: 14px;
  padding: 12px 20px;
}

#actionBtn:hover {
  background-color: #0369A1;
}

#actionBtn:pressed {
  background-color: #075985;
}

/* Danger (Rose/Red) */
#dangerBtn {
  background-color: #E11D48;
  color: #FFFFFF;
  font-size: 14px;
  padding: 12px 20px;
}

#dangerBtn:hover {
  background-color: #BE123C;
}

#dangerBtn:pressed {
  background-color: #9F1239;
}

QPushButton:disabled {
  background-color: #E2E8F0;
  color: #94A3B8;
  border-color: transparent;
}

/* --- チェックボックス --- */
QCheckBox {
  font-size: 13px;
  font-weight: 500;
  color: #334155;
  spacing: 8px;
}

QCheckBox::indicator {
  width: 18px;
  height: 18px;
  border-radius: 4px;
  border: 1px solid #CBD5E1;
  background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
  border-color: #2563EB;
}

QCheckBox::indicator:checked {
  background-color: #2563EB;
  border-color: #2563EB;
}

/* --- プログレスバー --- */
QProgressBar {
  background-color: #E2E8F0;
  border: none;
  border-radius: 4px;
  height: 6px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #2563EB;
  border-radius: 4px;
}

/* --- ログコンソール (Terminal Theme) --- */
#logConsole {
  background-color: #0B1120;
  color: #38BDF8;
  font-family: "SF Mono", "JetBrains Mono", "Menlo", "Courier New", monospace;
  font-size: 12px;
  line-height: 1.6;
  border-radius: 12px;
  border: 1px solid #1E293B;
  padding: 14px;
}

/* --- スクロールバー --- */
QScrollBar:vertical {
  border: none;
  background-color: transparent;
  width: 8px;
  margin: 4px 2px 4px 2px;
}

QScrollBar::handle:vertical {
  background-color: #CBD5E1;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::handle:vertical:hover {
  background-color: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
}

/* --- メッセージボックス (ダイアログ) --- */
QMessageBox {
  background-color: #FFFFFF;
}

QMessageBox QLabel {
  color: #1E293B;
  /* テキストをダークカラーに強制 */
  background-color: transparent;
}

QMessageBox QPushButton {
  background-color: #2563EB;
  /* デフォルトボタンを青色に */
  color: #FFFFFF;
  border-radius: 6px;
  padding: 6px 16px;
  min-width: 60px;
}

QMessageBox QPushButton:hover {
  background-color: #1D4ED8;
}